# Finly Environment Variables
# Copy to .env and fill in actual values for local development
# NEVER commit .env with real secrets to the repository
# This file is a template with placeholder values only

# ============================================================================
# SERVER & ENVIRONMENT
# ============================================================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ============================================================================
# DATABASE (PostgreSQL) - Used by Backend and CI/CD
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=finly_user
DB_PASSWORD=your_db_password_here
DB_NAME=finly_db
DB_SSL=false
DB_SSL_CERT_PATH=
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10

# Full connection string (used by some tools, can override individual vars above)
DATABASE_URL=postgresql://finly_user:your_db_password_here@localhost:5432/finly_db

# ============================================================================
# REDIS (Cache & Queue Backend)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================================
# FRONTEND - React Next.js
# ============================================================================
# Public variables (visible in browser, should not contain secrets)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_VERSION=v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
NEXT_PUBLIC_APPLE_CLIENT_ID=your_apple_client_id_here
NEXT_PUBLIC_APP_NAME=Finly
NEXT_PUBLIC_APP_ENV=development

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# JWT Secrets (minimum 32 characters, should be cryptographically random)
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=your_jwt_access_secret_here_min_32_chars_change_me
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars_change_me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# OAuth - Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth - Apple
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nyour_apple_private_key_pem_format\n-----END PRIVATE KEY-----

# CORS Configuration
CORS_ORIGIN=http://localhost:3001,http://localhost:3000
CORS_CREDENTIALS=true

# ============================================================================
# EXTERNAL SERVICES - SMS, Email, Push, Billing
# ============================================================================
# SMS Provider (Twilio)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@finly.app
SENDGRID_FROM_NAME=Finly

# Firebase Cloud Messaging (Push Notifications)
# Can be a file path or base64-encoded JSON
FIREBASE_SERVICE_ACCOUNT_KEY=/path/to/firebase-service-account-key.json

# Stripe (Billing & Payments)
STRIPE_API_KEY=sk_test_your_stripe_api_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================================================
# AWS CONFIGURATION (Infrastructure & File Storage)
# ============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# S3 Bucket for Report Exports and File Storage
AWS_S3_BUCKET=finly-dev-bucket
AWS_S3_REGION=us-east-1

# ============================================================================
# OBSERVABILITY & MONITORING
# ============================================================================
# Sentry Error Tracking
SENTRY_DSN=

# DataDog Monitoring
DATADOG_API_KEY=

# ============================================================================
# TERRAFORM / INFRASTRUCTURE (DevOps Only)
# ============================================================================
# These variables are used during infrastructure provisioning
TF_VAR_app_name=finly
TF_VAR_environment=development
TF_VAR_aws_region=us-east-1

# Demo tier specific (single EC2 instance, no ECS)
TF_VAR_demo_instance_type=t3.micro
TF_VAR_demo_ebs_volume_size=30

# Staging tier specific (ECS Fargate with auto-scaling)
TF_VAR_staging_instance_type=t3.small
TF_VAR_staging_desired_count=2
TF_VAR_staging_min_count=1
TF_VAR_staging_max_count=4
TF_VAR_staging_cpu=512
TF_VAR_staging_memory=1024

# Production tier specific (ECS Fargate with auto-scaling)
TF_VAR_production_instance_type=t3.medium
TF_VAR_production_desired_count=3
TF_VAR_production_min_count=2
TF_VAR_production_max_count=10
TF_VAR_production_cpu=1024
TF_VAR_production_memory=2048

# RDS Configuration
TF_VAR_rds_engine=postgres
TF_VAR_rds_engine_version=16.1
TF_VAR_rds_instance_class=db.t3.micro
TF_VAR_rds_allocated_storage=20
TF_VAR_rds_multi_az=false

# ============================================================================
# DOCKER COMPOSE (Local Development Only)
# ============================================================================
# These are used by docker-compose.yml for local development
COMPOSE_PROJECT_NAME=finly-dev
COMPOSE_PROFILES=dev

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=finly_user
DATABASE_PASSWORD=your_db_password_here
DATABASE_NAME=finly_db
DATABASE_SSL=false
