    "jsonwebtoken": "^9.0.1",
    "bcrypt": "^5.1.1",
    "redis": "^4.6.10",
    "pg": "^8.10.0",
    "joi": "^17.9.2",
    "uuid": "^9.0.0",
    "bullmq": "^4.11.0",
    "@sendgrid/mail": "^7.7.0",
    "firebase-admin": "^11.11.0",
    "stripe": "^14.5.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/bcrypt": "^5.0.0",
    "@types/uuid": "^9.0.2",
    "typescript": "^5.1.3",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^5.59.11",
    "@typescript-eslint/parser": "^5.59.11",
    "eslint": "^8.44.0",
    "jest": "^29.5.0",
