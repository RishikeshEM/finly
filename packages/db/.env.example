# PostgreSQL Database Configuration
# ===================================

# Option 1: Full connection string (takes precedence over individual variables)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=

# Option 2: Individual connection parameters (used if DATABASE_URL is not set)
# Database host
DB_HOST=localhost

# Database port
DB_PORT=5432

# Database user
DB_USER=finly_user

# Database password
DB_PASSWORD=

# Database name
DB_NAME=finly

# Use SSL/TLS for database connection (true/false)
# Set to 'true' in staging/production
DB_SSL=false

# SSL certificate path (if using custom CA)
DB_SSL_CERT_PATH=

# SSL certificate key path (if using mutual TLS)
DB_SSL_CERT_KEY=

# Whether to reject unauthorized SSL certificates (true/false)
# Set to 'false' only for self-signed certificates in development
DB_SSL_REJECT_UNAUTHORIZED=true

# Connection pool configuration
# Maximum number of concurrent connections
DB_POOL_MAX=10

# Idle connection timeout in milliseconds
DB_IDLE_TIMEOUT_MS=30000

# Connection attempt timeout in milliseconds
DB_CONNECTION_TIMEOUT_MS=5000
